{
  "name": "mcp-index",
  "version": "0.1.0",
  "description": "Index the MCP server ecosystem and aggregate many servers behind one sandboxed MCP endpoint.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "aggregator",
    "gateway",
    "registry",
    "index",
    "sandbox",
    "bubblewrap"
  ],
  "homepage": "https://github.com/KingTunaThe7th/mcp-index#readme",
  "bugs": {
    "url": "https://github.com/KingTunaThe7th/mcp-index/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KingTunaThe7th/mcp-index.git"
  },
  "author": "KingTunaThe7th <kurokagerin@gmail.com>",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
    "mcp-index": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "node --import tsx --test test/*.test.ts",
    "dev": "tsx src/cli.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "commander": "^15.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
